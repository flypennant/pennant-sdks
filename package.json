{
  "name": "pennant-sdks",
  "private": true,
  "type": "module",
  "workspaces": [
    "js",
    "node",
    "react",
    "vue"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test js/src/*.test.ts node/src/*.test.ts vue/src/*.test.ts scripts/release.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "release": "node scripts/release.mjs --dry-run",
    "prepare": "husky && sh scripts/link-agent-skills.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vue": "^3.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
