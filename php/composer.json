{
  "name": "flypennant/pennant",
  "description": "PHP client for the Pennant feature-flag evaluate API",
  "type": "library",
  "license": "MIT",
  "homepage": "https://flypennant.com",
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "pennant"
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "suggest": {
    "ext-curl": "Used for HTTP when present. Without it the client falls back to PHP streams."
  },
  "autoload": {
    "psr-4": {
      "Pennant\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pennant\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true
  }
}
